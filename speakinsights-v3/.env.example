# =============================================================================
# SpeakInsights v3 — Environment Variables
# =============================================================================
# Copy this file to .env and customize values as needed:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit — WebRTC server authentication
# -----------------------------------------------------------------------------
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret1234567890abcdef12345678

# LiveKit external URL — the URL browsers use to connect to LiveKit.
# For local development: ws://localhost:7880
# For Cloudflare tunnel: this is auto-detected by the frontend, but the backend
# still needs this for token generation context. Set to your tunnel URL:
# LIVEKIT_EXTERNAL_URL=wss://your-tunnel.trycloudflare.com/livekit-ws/
LIVEKIT_EXTERNAL_URL=ws://localhost:7880

# -----------------------------------------------------------------------------
# PostgreSQL — Database password
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=speakinsights

# -----------------------------------------------------------------------------
# HuggingFace — Token for WhisperX diarization models (optional)
# -----------------------------------------------------------------------------
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token

# -----------------------------------------------------------------------------
# Ollama — LLM inference
# -----------------------------------------------------------------------------
# Mac (native Ollama with Metal acceleration):
OLLAMA_URL=http://host.docker.internal:11434
# Windows (Ollama in Docker — set by setup-windows script):
# OLLAMA_URL=http://ollama:11434

# Default model for summarization and chat
OLLAMA_MODEL=llama3.2:3b

# -----------------------------------------------------------------------------
# WhisperX — Transcription model
# -----------------------------------------------------------------------------
# Options: tiny, base, small, medium, large-v2, large-v3
WHISPERX_MODEL=small

# -----------------------------------------------------------------------------
# Language — Default transcription language
# -----------------------------------------------------------------------------
# Set to "auto" for auto-detection, or use ISO 639-1 codes (en, es, fr, de, etc.)
DEFAULT_LANGUAGE=auto

# -----------------------------------------------------------------------------
# CORS — Allowed origins for frontend
# -----------------------------------------------------------------------------
# For local development:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# For Cloudflare tunnel, add your tunnel URL:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-tunnel.trycloudflare.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
