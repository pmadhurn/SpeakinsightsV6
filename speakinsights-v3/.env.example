# =============================================================================
# SpeakInsights v3 — Environment Variables
# =============================================================================
# Copy this file to .env and customize values as needed:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit Cloud — WebRTC media server (replaces self-hosted LiveKit)
# -----------------------------------------------------------------------------
# Get these from https://cloud.livekit.io → Project Settings → Keys
LIVEKIT_API_KEY=your_livekit_cloud_api_key
LIVEKIT_API_SECRET=your_livekit_cloud_api_secret

# LiveKit Cloud URL — your project's WebSocket URL from the LiveKit Cloud dashboard.
# Format: wss://<your-project>.livekit.cloud
# This is used by BOTH the backend (API calls) and frontend (browser WebRTC).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_EXTERNAL_URL=wss://your-project.livekit.cloud

# -----------------------------------------------------------------------------
# PostgreSQL — Database password
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=speakinsights

# -----------------------------------------------------------------------------
# HuggingFace — Token for WhisperX diarization models (optional)
# -----------------------------------------------------------------------------
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token

# -----------------------------------------------------------------------------
# LLM Provider — choose between local Ollama and cloud OpenRouter
# -----------------------------------------------------------------------------
# "ollama" = local inference (default, no API cost, requires Ollama running)
# "openrouter" = cloud inference via OpenRouter API (requires API key)
LLM_PROVIDER=ollama

# -----------------------------------------------------------------------------
# Ollama — Local LLM inference
# -----------------------------------------------------------------------------
# Mac (native Ollama with Metal acceleration):
OLLAMA_URL=http://host.docker.internal:11434
# Windows (Ollama in Docker — set by setup-windows script):
# OLLAMA_URL=http://ollama:11434

# Default model for summarization and chat
OLLAMA_MODEL=llama3.2:3b

# -----------------------------------------------------------------------------
# OpenRouter — Cloud LLM inference (optional)
# -----------------------------------------------------------------------------
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Default model (free models available: minimax/minimax-m2.5:free, etc.)
OPENROUTER_MODEL=minimax/minimax-m2.5:free
# Enable chain-of-thought reasoning (recommended for MiniMax)
OPENROUTER_REASONING=true

# -----------------------------------------------------------------------------
# WhisperX — Transcription model
# -----------------------------------------------------------------------------
# Options: tiny, base, small, medium, large-v2, large-v3
WHISPERX_MODEL=small

# -----------------------------------------------------------------------------
# Language — Default transcription language
# -----------------------------------------------------------------------------
# Set to "auto" for auto-detection, or use ISO 639-1 codes (en, es, fr, de, etc.)
DEFAULT_LANGUAGE=auto

# -----------------------------------------------------------------------------
# CORS — Allowed origins for frontend
# -----------------------------------------------------------------------------
# For local development:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# For Cloudflare tunnel, add your tunnel URL:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-tunnel.trycloudflare.com
CORS_ORIGINS=*
